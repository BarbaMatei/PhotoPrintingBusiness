# Caddy reverse proxy for FotoTipar (production).
# SITE_ADDRESS (e.g. fototipar.ro) is injected from .env by docker-compose.prod.yml.
# On first boot against a real, DNS-pointed hostname, Caddy obtains and renews a
# Let's Encrypt certificate automatically. For pre-cutover testing against a domain
# whose DNS isn't final, uncomment the staging CA line to avoid LE rate limits.

# {
#     acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }

{$SITE_ADDRESS} {
	encode gzip zstd

	# The Prometheus scrape path is served on the API's internal scrape port only.
	# The edge must never route it: proxied requests all share this container's IP,
	# so the API-side allow-list cannot tell an operator from the public internet.
	# Keep in sync with Observability:Metrics:PrometheusEndpoint if that is changed.
	handle /metrics* {
		respond 404
	}

	handle {
		reverse_proxy api:8080 {
			# A caller must not choose our Sentry sampling, nor seed the baggage we send onward.
			# traceparent is deliberately kept: §14.7 documents it as the way to force a trace.
			header_up -sentry-trace
			header_up -baggage
			# Replace, not append: the API reads the last entry, and this leaves a caller's own
			# X-Forwarded-For no way to reach it. There is no proxy hop in front of this one.
			header_up X-Forwarded-For {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log
	}
}
