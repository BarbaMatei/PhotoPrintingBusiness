# ──────────────────────────────────────────────────────────────────────────────
#  FotoTipar environment template.  Copy to `.env` and fill in real values.
#  `.env` is gitignored; THIS file (.env.example) is committed with no secrets.
#
#  Config-key convention: ASP.NET Core maps `Section:Key` to `Section__Key`
#  (double underscore) as an environment variable.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080;http://+:9090   # 9090 = the /metrics scrape listener (§14.3);
                                              # must match Observability__Metrics__ScrapePort below
ConnectionStrings__Default=Host=db;Port=5432;Database=fototipar;Username=fototipar;Password=CHANGE_ME
App__BaseUrl=https://fototipar.ro

# ── Deploy / image (used by docker-compose.prod.yml) ──────────────────────────
GHCR_OWNER=your-github-org-or-user
IMAGE_TAG=latest
SITE_ADDRESS=fototipar.ro

# ── JWT signing (RS256) ───────────────────────────────────────────────────────
# Generate a keypair with scripts/gen-dev-keys.sh|.ps1. Paste the PEM as a single
# line with literal \n between lines, or use `dotnet user-secrets` in local dev.
# The API FAILS TO START if this is empty — that is intentional.
JwtSettings__PrivateKeyPem=
JwtSettings__Issuer=fototipar
JwtSettings__Audience=fototipar-spa
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=30

# ── CORS (comma-separated exact origins) ──────────────────────────────────────
Cors__AllowedOrigins=https://fototipar.ro

# ── Email ─────────────────────────────────────────────────────────────────────
Email__Provider=Smtp                 # Smtp (dev / MailHog) | SendGrid (prod)
Email__FromAddress=noreply@fototipar.ro
Email__FromName=FotoTipar
Email__Smtp__Host=mailhog
Email__Smtp__Port=1025
Email__Smtp__UseSsl=false
Email__SendGrid__ApiKey=             # required when Email__Provider=SendGrid

# ── Payments — Stripe (REQUIRED in Production; boot fails if SecretKey empty) ──
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GoogleAuth__ClientId=

# ── Health / storage ──────────────────────────────────────────────────────────
HealthCheck__UploadsPath=Storage

# ── Reverse-proxy trust (see DEPLOYMENT.md §16) ───────────────────────────────
# Shipped ON. Leaving it off is not the safe default: the client identity would be Caddy for
# every request, so one rate-limit bucket serves the whole internet (one page load can 429
# everyone) and the refresh cookie ships without Secure.
# The value is Caddy's fixed address from docker-compose.prod.yml. Name the proxy alone,
# never the container subnet — every host in the range could then forge a client IP, and
# boot refuses a range wider than a single address pair.
ForwardedHeaders__TrustedProxies__0=172.28.0.2

# Trusting the proxy is what first makes this a PER-CLIENT budget, and it counts every static
# asset of a page load and every gallery thumbnail. 600/60s fits a first load plus a browse
# with room to spare; the appsettings default of 100 does not. MEASURE YOUR OWN SITE (§16.3
# item 1) and raise it if the network panel shows more. The boot log prints the value in force.
RateLimit__Public__PermitLimit=600

# ── Tracing + metrics (off by default; see DEPLOYMENT.md §14 BEFORE enabling) ──
Observability__Enabled=false
Observability__Otlp__Endpoint=                    # blank ⇒ no traces at all here; stdout spans are Development-only
Observability__Otlp__Protocol=Grpc                # Grpc | HttpProtobuf
Observability__Metrics__ScrapePort=9090           # listener that may serve /metrics; Caddy proxies 8080 only
Observability__Metrics__AllowedScrapeIps__0=127.0.0.1
# Add the scraper's address, or the dynamic pool Compose assigns containers from
# (docker-compose.prod.yml ipam.ip_range — keep the two in step, or scrapes get 403):
# Observability__Metrics__AllowedScrapeIps__1=172.28.0.128/25
# NEVER add Caddy's address here — every proxied request carries it (DEPLOYMENT.md §14.3).
Observability__Sampling__Default=1.0
