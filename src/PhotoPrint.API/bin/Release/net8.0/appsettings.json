{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=photoPrint;Username=photoPrint;Password=changeme"
  },
  "HealthCheck": {
    "UploadsPath": "uploads"
  },
  "Email": {
    "Provider": "SendGrid",
    "FromAddress": "noreply@fototipar.ro",
    "FromName": "FotoTipar",
    "OperatorBcc": "",
    "SendGrid": {
      "ApiKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": "https://fototipar.ro"
  },
  "RateLimit": {
    "WindowSeconds": 60,
    "Public": { "PermitLimit": 100 },
    "Auth": { "PermitLimit": 10 }
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' https://js.stripe.com https://accounts.google.com; frame-src https://js.stripe.com; connect-src 'self' https://api.stripe.com; frame-ancestors 'none'; object-src 'none'"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
