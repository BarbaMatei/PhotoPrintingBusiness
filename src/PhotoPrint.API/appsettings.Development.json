{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=photoPrint;Username=photoPrint;Password=set-in-appsettings.Development.Local.json"
  },
  "Storage": {
    "BasePath": "uploads"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  },
  "JwtSettings": {
    "PrivateKeyPem": "",
    "Issuer": "fototipar",
    "Audience": "fototipar-spa",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "App": {
    "BaseUrl": "http://localhost:4200"
  },
  "Stripe": {
    "SecretKey": "sk_test_placeholder",
    "WebhookSecret": "whsec_placeholder"
  },
  "Sameday": {
    "_comment": "Dev uses Sameday's sandbox. Real credentials live in user-secrets, never here.",
    "Enabled": false,
    "BaseUrl": "https://sameday-api.demo.sameday.ro",
    "RequestTimeoutSeconds": 10
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "noreply@fototipar.ro",
    "FromName": "FotoTipar",
    "OperatorBcc": "",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseSsl": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext:l}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RateLimit": {
    "WindowSeconds": 60,
    "Public": { "PermitLimit": 2000 },
    "Auth":   { "PermitLimit": 100  }
  }
}
