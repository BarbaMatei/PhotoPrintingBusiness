@{
    Layout = "_Layout";
}
<h2 style="margin:0 0 16px;font-size:22px;color:#d32f2f;">Comanda ta a fost anulată, @Model.FirstName</h2>

<p>
  Comanda <strong>#@Model.OrderNumber</strong> a fost anulată de echipa FotoTipar.
</p>

@if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
{
  <div style="background-color:#fff8f8;border-left:4px solid #d32f2f;padding:16px 20px;margin:24px 0;border-radius:4px;">
    <p style="margin:0 0 6px;font-weight:bold;color:#424242;">Motivul anulării:</p>
    <p style="margin:0;color:#616161;">@Model.CancellationReason</p>
  </div>
}

<div style="background-color:#f1f8e9;border-left:4px solid #558b2f;padding:16px 20px;margin:24px 0;border-radius:4px;">
  <p style="margin:0 0 6px;font-weight:bold;color:#424242;">Rambursare:</p>
  <p style="margin:0;color:#424242;">
    Suma de <strong>@Model.TotalRon.ToString("0.00") RON</strong> va fi rambursată
    pe cardul folosit la plată în 3–5 zile lucrătoare, conform politicii procesatorului de plăți.
  </p>
</div>

<p>
  Dacă ai întrebări sau crezi că este o eroare, te rugăm să ne contactezi la
  <a href="mailto:contact@fototipar.ro" style="color:#c62828;">contact@fototipar.ro</a>.
</p>

<p style="margin-top:32px;">
  <a href="@Model.OrderUrl"
     style="display:inline-block;background:#1a73e8;color:#fff;text-decoration:none;
            padding:12px 24px;border-radius:6px;font-weight:600;">
    Vezi detaliile comenzii
  </a>
</p>

<p style="color:#9e9e9e;font-size:13px;margin-top:32px;">
  Îți mulțumim că ai folosit FotoTipar. Sperăm să te revedem curând!
</p>
